{
  "name": "tsukikage-pachinko",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "sync": "npm run build && cap sync",
    "test:browser": "node tests/session-controls.browser.mjs",
    "export:editor": "node tools/export-editor.mjs",
    "build:previews": "vite build --mode previews --outDir dist-previews",
    "test:previews": "node tests/preview-navigation.browser.mjs",
    "build:release": "vite build --mode release",
    "preview:release": "vite preview --mode release --host 127.0.0.1",
    "deploy": "npm run release:publish",
    "test:release": "node tests/release.browser.mjs",
    "release:prepare": "node tools/release-workflow.js prepare",
    "release:verify": "node tools/release-workflow.js verify",
    "release:publish": "node tools/release-workflow.js publish"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "@fontsource/dotgothic16": "^5.3.0",
    "pixi.js": "^8.21.0",
    "playcanvas": "2.22.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "1.63.0",
    "sharp": "^0.35.5",
    "three": "0.186.0",
    "vite": "8.3.0",
    "wrangler": "^4.147.0"
  }
}
